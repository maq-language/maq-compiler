{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        },
        {
          "src": "../tools",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "../obj/docfx/api",
      "includePrivateMembers": true,
      "properties": {
        "TargetFramework": "net10.0"
      },
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      "**/*.{md,yml}",
      {
        "src": "../obj/docfx/api",
        "files": [
          "**/*.yml"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      "**/images/**",
      "**/media/**"
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Maq Compiler",
      "_appTitle": "Maq Compiler Documentation",
      "_disableContribution": true,
      "_enableSearch": true,
      "_enableNewTab": true
    }
  }
}
